# ─── Sesión ──────────────────────────────────────────────────────────────────
# Secreto con el que se firma la cookie de sesión (HMAC-SHA256).
# OBLIGATORIA: sin ella nadie puede iniciar sesión — el login devuelve 500.
# Mínimo 32 caracteres. Generar una con:  openssl rand -hex 32
# Usar valores distintos en local y en producción, y no reutilizarla en otro lado.
# Cambiarla cierra todas las sesiones abiertas.
SESSION_SECRET=

# ─── Google Sheets (Service Account) ────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="your-google-private-key-with-escaped-newlines"

# ─── IDs de Spreadsheets ─────────────────────────────────────────────────────
SHEET_PRODUCCION_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Distribuidora — solo gastos (sus ventas se registran en ConectOca/Producción)
SHEET_DISTRIBUIDORA_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHEET_LA_REINA_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHEET_PV_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHEET_PT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHEET_BILBAO_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHEET_VENTAS_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHEET_CONTROL_PAN_ID — descontinuado, reemplazado por Supabase Control Pan
# SHEET_CONTROL_PAN_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Control Pan — Supabase (proyecto separado) ──────────────────────────────
CONTROLPAN_SUPABASE_URL=https://your-controlpan-project.supabase.co
CONTROLPAN_SUPABASE_KEY=your-controlpan-anon-or-publishable-key

# ─── PredictHQ (Eventos cercanos a los locales) ──────────────────────────────
# Registro gratuito en https://www.predicthq.com  (free tier: 200 requests/mes)
PREDICTHQ_API_KEY=

# ─── Supabase (ConectOca) ────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Informes automáticos por correo (Resend + Netlify Scheduled Functions) ──
# Configurar estas 6 en el panel de Netlify (Site settings → Environment
# variables), no solo acá. Este .env.example es solo referencia local.
#
# API key de Resend (Dashboard → API Keys). Generar una nueva; nunca commitear
# el valor real.
RESEND_API_KEY=re_REEMPLAZA
# Remitente. Requiere que el dominio esté verificado en Resend (Dashboard →
# Domains → Add Domain → agregar los registros DNS que te den).
RESEND_FROM=informes@finanzasoca.com
# Token que valida las llamadas de las Netlify Scheduled Functions al
# endpoint /api/informes/cron. Generar con: openssl rand -hex 32
CRON_SECRET=un-token-secreto-largo
# URL pública del sitio en producción (la usan las scheduled functions y el
# cron para llamarse a sí mismos).
NEXT_PUBLIC_BASE_URL=https://tu-sitio.netlify.app
# Destinatarios normales, separados por coma (no ven gastoFijoData).
REPORT_RECIPIENTS=tu@email.com
# Destinatarios admin, separados por coma (reciben el informe completo,
# incluyendo gastoFijoData). Opcional.
REPORT_RECIPIENTS_ADMIN=
